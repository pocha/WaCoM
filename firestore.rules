rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMod(communityId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/Communities/$(communityId)).data.mods;
    }

    // Mods/{uid} holds the mod's Watobot API key, name, and the list of
    // community jids Watobot has verified them as admin of (`communities`,
    // written only by the listMyCommunities Function). A mod may read their
    // own doc — needed to call Watobot directly from the browser — but
    // never write it: `api_key` must stay tied to whatever validateAndSignIn
    // actually verified, and `communities` must stay a server-verified fact,
    // not something a client could self-declare to unlock writes on
    // Communities/{jid} below.
    match /Mods/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /Communities/{communityId} {
      // A mod can only see communities they administer.
      //
      // Checked directly against resource.data (not the isMod() helper's
      // get() indirection) since the dashboard/sidebar query this
      // collection with where('mods', 'array-contains', uid) — Firestore
      // can only allow a list/query request when the rule is a direct
      // comparison against resource.data matching the query's own filter,
      // not one routed through a get() call.
      allow read: if request.auth != null && request.auth.uid in resource.data.mods;

      // Onboarding (creating this doc, or a second mod joining an existing
      // one) is a direct client write, gated on the caller's own
      // Mods/{uid}.communities — populated only by listMyCommunities after
      // it verifies admin status against Watobot, so this can't be
      // satisfied by anything the client itself controls. The extra checks
      // stop a write from onboarding without including yourself, or from
      // dropping an existing mod out of an already-onboarded community.
      allow write: if request.auth != null &&
        communityId in get(/databases/$(database)/documents/Mods/$(request.auth.uid)).data.communities &&
        request.auth.uid in request.resource.data.mods &&
        (!exists(/databases/$(database)/documents/Communities/$(communityId)) ||
          request.resource.data.mods.hasAll(resource.data.mods));

      match /Forms/{formId} {
        // Public read: the unauthenticated application form page needs
        // this. Writes (creating/deactivating forms) only by a mod of the
        // parent community.
        allow read: if true;
        allow write: if isMod(communityId);
      }

      match /Applicants/{applicantId} {
        // Mods can read and update applicants for communities they
        // administer (approve/reject). Creation stays Function-only
        // (submitApplication) since an anonymous public submitter must be
        // validated/deduplicated server-side, not trusted with a direct
        // write. The hourly join-check cron runs on the Admin SDK, which
        // bypasses these rules entirely.
        allow read, update: if isMod(communityId);
        allow create: if false;
      }
    }
  }
}
